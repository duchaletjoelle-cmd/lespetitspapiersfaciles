# Variables d'environnement — copier en .env et remplir
# Ne jamais committer .env sur GitHub

# ── Modèle de langage (OpenRouter) ───────────────────────────────────────────
# Clé sur openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-...
# Modèle utilisé — changer sans toucher au code
# Options économiques : anthropic/claude-haiku-4-5  |  openai/gpt-4o-mini
# Options puissantes : anthropic/claude-sonnet-4-5  |  openai/gpt-4o
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# ── Base de données (PostgreSQL) ─────────────────────────────────────────────
# Fourni automatiquement par Render quand la base est liée au service.
# En local : installer PostgreSQL et créer une base, ou laisser vide (mode mémoire).
DATABASE_URL=postgresql://user:motdepasse@localhost:5432/agents_ia_tpe

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID du Sheet (dans l'URL : docs.google.com/spreadsheets/d/SHEET_ID/...)
GOOGLE_SHEET_ID=15G63iHQAT_BbDfi0T6A0qVjveBgNZUnvPyPq8-Bsl20

# Credentials du compte de service Google — DEUX options, utiliser l'une ou l'autre :
#
# Option A (cloud / Render) : coller le contenu JSON complet en une seule ligne
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
#
# Option B (local) : chemin vers le fichier JSON téléchargé
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── E-mail pro (Brevo) ───────────────────────────────────────────────────────
# Clé sur brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=assistant@lespetitspapiersfaciles.fr
EMAIL_FROM_NAME=Assistant Les Petits Papiers Faciles

# ── Adresse e-mail du pro par métier ─────────────────────────────────────────
# Utilisée par relance.py pour envoyer les rappels.
# EMAIL_PRO = adresse par défaut si le métier n'a pas la sienne.
EMAIL_PRO=sandra@lespetitspapiersfaciles.fr
# EMAIL_PRO_CAVISTE=caviste@exemple.fr
# EMAIL_PRO_BOULANGERIE=boulangerie@exemple.fr

# ── SMS (optionnel, non activé en V0) ────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Configuration générale ────────────────────────────────────────────────────
# Métier actif : caviste | boulangerie | coiffure | restaurant-traiteur | artisan-batiment | garage
METIER=caviste
PORT=8080
RELANCE_SEUIL_HEURES=24
