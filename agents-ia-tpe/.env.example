# Clés API — copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS committer le fichier .env sur GitHub

# --- Anthropic (modèle de langage) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Sheets ---
# ID du Google Sheet (visible dans l'URL : docs.google.com/spreadsheets/d/SHEET_ID/...)
GOOGLE_SHEET_ID=15G63iHQAT_BbDfi0T6A0qVjveBgNZUnvPyPq8-Bsl20
# Chemin vers le fichier JSON du compte de service Google
# (téléchargé depuis console.cloud.google.com → IAM → Comptes de service)
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Email (Brevo / SendGrid / Gmail SMTP) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
# Adresse d'expédition vérifiée dans Brevo
EMAIL_FROM=assistant@lespetitspapiersfaciles.fr
EMAIL_FROM_NAME=Assistant Les Petits Papiers Faciles

# --- SMS (optionnel, V0 non obligatoire) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Métier actif (caviste | boulangerie | coiffure | restaurant-traiteur | artisan-batiment | garage) ---
METIER=caviste

# --- Port du serveur web local (maillon 1) ---
PORT=8080
